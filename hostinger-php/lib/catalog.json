{
 "apps": [
  {
   "key": "webhook",
   "name": "Webhooks",
   "icon": "↔",
   "color": "#ececff",
   "category": "Core",
   "desc": "Start a workflow from any website, form or app that can send an HTTP request.",
   "auth": "none",
   "triggers": [
    {
     "key": "catch",
     "label": "Catch webhook",
     "desc": "Runs when JSON, form data or query params hit this workflow's unique URL.",
     "fields": []
    }
   ]
  },
  {
   "key": "schedule",
   "name": "Schedule",
   "icon": "◷",
   "color": "#fff1d9",
   "category": "Core",
   "desc": "Run a workflow every few minutes, hours or days.",
   "auth": "none",
   "triggers": [
    {
     "key": "every",
     "label": "Every N minutes",
     "desc": "Fires on the cron tick once the interval has passed.",
     "fields": [
      {
       "key": "minutes",
       "label": "Interval (minutes)",
       "type": "number",
       "required": true,
       "default": "60"
      }
     ]
    }
   ]
  },
  {
   "key": "rss",
   "name": "RSS / Blog feed",
   "icon": "◉",
   "color": "#ffe9dc",
   "category": "Core",
   "desc": "Trigger on new items in an RSS or Atom feed (blogs, YouTube channels, news).",
   "auth": "none",
   "triggers": [
    {
     "key": "new_item",
     "label": "New item in feed",
     "desc": "Checked on every cron tick. Output: title, link, description, published, id.",
     "fields": [
      {
       "key": "feedUrl",
       "label": "Feed URL",
       "type": "url",
       "required": true,
       "placeholder": "https://example.com/feed.xml",
       "help": "YouTube channel feed: https://www.youtube.com/feeds/videos.xml?channel_id=…"
      }
     ]
    }
   ]
  },
  {
   "key": "http",
   "name": "HTTP Request",
   "icon": "⇄",
   "color": "#e6f0ff",
   "category": "Core",
   "desc": "Call any REST API — CRMs, n8n, Make, your own backend.",
   "auth": "none",
   "actions": [
    {
     "key": "request",
     "label": "Send HTTP request",
     "desc": "Output: status, headers, body (parsed JSON when possible).",
     "fields": [
      {
       "key": "method",
       "label": "Method",
       "type": "select",
       "options": [
        "POST",
        "GET",
        "PUT",
        "PATCH",
        "DELETE"
       ],
       "default": "POST"
      },
      {
       "key": "url",
       "label": "URL",
       "type": "url",
       "required": true
      },
      {
       "key": "headers",
       "label": "Headers (JSON)",
       "type": "json",
       "placeholder": "{\"Authorization\":\"Bearer …\"}"
      },
      {
       "key": "body",
       "label": "Body",
       "type": "textarea",
       "placeholder": "{\"name\":\"{{trigger.name}}\"}"
      }
     ]
    }
   ]
  },
  {
   "key": "filter",
   "name": "Filter",
   "icon": "⑂",
   "color": "#fff1d9",
   "category": "Core",
   "desc": "Only continue when a condition is true.",
   "auth": "none",
   "actions": [
    {
     "key": "only_if",
     "label": "Only continue if…",
     "desc": "Stops the run (status: filtered) when the condition fails.",
     "fields": [
      {
       "key": "left",
       "label": "Value",
       "required": true,
       "placeholder": "{{trigger.email}}"
      },
      {
       "key": "operator",
       "label": "Condition",
       "type": "select",
       "options": [
        "exists",
        "does not exist",
        "equals",
        "does not equal",
        "contains",
        "does not contain",
        "greater than",
        "less than"
       ],
       "default": "exists"
      },
      {
       "key": "right",
       "label": "Compare to",
       "placeholder": "Leave empty for exists checks"
      }
     ]
    }
   ]
  },
  {
   "key": "formatter",
   "name": "Formatter",
   "icon": "Aa",
   "color": "#f0f0f0",
   "category": "Core",
   "desc": "Compose text from earlier steps, trim it to a length, or add today's date.",
   "auth": "none",
   "actions": [
    {
     "key": "compose",
     "label": "Compose text",
     "desc": "Output: text, length.",
     "fields": [
      {
       "key": "template",
       "label": "Text",
       "type": "textarea",
       "required": true,
       "placeholder": "New post: {{trigger.title}} {{trigger.link}}"
      },
      {
       "key": "maxLength",
       "label": "Max length (optional)",
       "type": "number",
       "placeholder": "280"
      }
     ]
    }
   ]
  },
  {
   "key": "claude",
   "name": "Claude AI",
   "icon": "✳",
   "color": "#f8e6dc",
   "category": "AI",
   "desc": "Write captions, summarise leads, translate or classify text with Claude.",
   "auth": "token",
   "authFields": [
    {
     "key": "apiKey",
     "label": "Anthropic API key",
     "type": "password",
     "required": true
    }
   ],
   "authHelp": "Create a key at console.anthropic.com → API keys.",
   "actions": [
    {
     "key": "generate",
     "label": "Generate text",
     "desc": "Output: text.",
     "fields": [
      {
       "key": "prompt",
       "label": "Prompt",
       "type": "textarea",
       "required": true,
       "placeholder": "Write a short Instagram caption for: {{trigger.title}}"
      },
      {
       "key": "system",
       "label": "Instructions (optional)",
       "type": "textarea",
       "placeholder": "Reply with the caption only."
      },
      {
       "key": "model",
       "label": "Model",
       "type": "select",
       "options": [
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
       ],
       "default": "claude-opus-5-5"
      },
      {
       "key": "effort",
       "label": "Effort",
       "type": "select",
       "options": [
        "low",
        "medium",
        "high"
       ],
       "default": "low"
      }
     ]
    }
   ]
  },
