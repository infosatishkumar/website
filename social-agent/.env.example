# ── Claude (required) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium

# ── Safety ────────────────────────────────────────────────────
# DRY_RUN=true      -> show what would be posted/sent, send nothing
# AUTO_APPROVE=true -> post/send without asking each time (not recommended)
DRY_RUN=false
AUTO_APPROVE=false

# ── Facebook Page + Instagram (Meta Graph API) ────────────────
# META_GRAPH_VERSION=v23.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram professional account linked to the Page above
IG_USER_ID=

# ── YouTube (Google OAuth) ────────────────────────────────────
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ── X / Twitter (OAuth 2.0 user access token) ─────────────────
X_USER_ACCESS_TOKEN=

# ── LinkedIn ──────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:XXXX (yourself) or urn:li:organization:XXXX (company page)
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202509
