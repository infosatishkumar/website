# ---- Karishma ki settings ----
# Claude API key (brain): https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ElevenLabs API key (voice): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=xxxxxxxx
# ElevenLabs voice ID (Voice Library me se koi female Hindi voice choose karo, uska ID yahan daalo)
ELEVENLABS_VOICE_ID=
# flash_v2_5 = sabse tez (Hindi bhi). Zyada natural chahiye to eleven_multilingual_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Brain (AI) kaun sa use ho ----
# claude | openai | gemini | groq | openrouter | deepseek | ollama | custom
KARISHMA_BRAIN=claude
# Main API ke credits khatam / key kharab ho to apne aap isse chalegi (comma se kai de sakte ho)
KARISHMA_BACKUP_BRAIN=
# Dusri companies ki keys (jo use karni ho wahi bharo)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Model badalna ho to (khaali = default):  KARISHMA_OPENAI_MODEL=  KARISHMA_GEMINI_MODEL=  KARISHMA_GROQ_MODEL= ...
# Koi aur OpenAI-compatible API:
KARISHMA_CUSTOM_BASE_URL=
KARISHMA_CUSTOM_API_KEY=
KARISHMA_CUSTOM_MODEL=

# Claude model aur effort (low = fast jawab, medium = balanced, high = zyada soch-samajh)
KARISHMA_MODEL=claude-opus-5-5
KARISHMA_EFFORT=low

# Aapka naam / city (Karishma ise yaad rakhegi)
KARISHMA_USER_NAME=
KARISHMA_USER_CITY=

# App: true = sirf "Karishma" bolke bulao (Mac par orange mic dot hamesha dikhega)
#      false = "Hey Siri, Karishma" / shortcut / click se bulao (dot sirf baat karte waqt)
KARISHMA_MIC_ALWAYS_ON=true

# Karishma ke taaron ka rang: gradient ya white
KARISHMA_STAR_COLOR=gradient

# Listening mode (terminal): wake = "Karishma" bolne par jaagegi, always = har baat sunegi, ptt = Enter dabake bolo
KARISHMA_LISTEN_MODE=wake

# Browser: chromium (Playwright wala) ya chrome (aapka installed Google Chrome)
KARISHMA_BROWSER_CHANNEL=chromium
