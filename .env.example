NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- FlowForge (/flowforge) -------------------------------------------------
# Required in production
FLOWFORGE_ADMIN_PASSWORD=
FLOWFORGE_SECRET=            # long random string; encrypts stored credentials
SUPABASE_SERVICE_ROLE_KEY=   # server-only; enables cloud storage (run supabase/flowforge.sql)
CRON_SECRET=                 # protects /api/flowforge/cron
FLOWFORGE_APP_URL=           # optional, e.g. https://yoursite.com (auto-detected otherwise)

# One-click OAuth connect (create a developer app per platform)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Optional API version overrides
META_GRAPH_VERSION=v26.0
LINKEDIN_API_VERSION=202608
